rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only when the signed-in user's ID matches the {userId} in the path.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Server-side validation so bad data is rejected even if the frontend is bypassed.
    function isValidExpense(data) {
      return data.keys().hasOnly(['title', 'amount', 'category', 'date', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'amount', 'category', 'date', 'description'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && data.category in ['Food', 'Transport', 'Shopping', 'Education', 'Bills', 'Healthcare', 'Other']
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.description is string && data.description.size() <= 300;
    }

    // Each user can only touch documents under /users/<their own uid>/expenses
    match /users/{userId}/expenses/{expenseId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidExpense(request.resource.data);
    }

    // Everything else is denied by default.
  }
}
